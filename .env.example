# ==============================================================================
# Переменные окружения для "Кофейня → Производство (Coffee ERP)"
# Скопируйте этот файл в .env и настройте параметры для вашего сервера:
# cp .env.example .env
# ==============================================================================

# Порт HTTP-сервера приложения (по умолчанию 3000)
PORT=3000

# Режим окружения. НЕ раскомментируйте в .env для локальной разработки:
# при NODE_ENV=production `npm run dev` не запускает Vite и ищет собранный dist/.
# Скрипт `npm start` сам выставляет NODE_ENV=production.
# NODE_ENV=production

# Отключение HMR в iframe / продакшн окружении (true по умолчанию)
DISABLE_HMR=true

# Часовой пояс сервера (по умолчанию московское время для синхронизации дедлайнов слотов)
TZ=Europe/Moscow

# ------------------------------------------------------------------------------
# Подключение к YDB Cloud
# ------------------------------------------------------------------------------
# Получите endpoint и database path в консоли YDB Cloud.
# Пока значения пусты (YDB_ENDPOINT=""), приложение считает, что БД не настроена, и вход невозможен.
# В панели хостинга (Vercel) вставляйте значения БЕЗ кавычек и пробелов.
YDB_ENDPOINT=""
YDB_DATABASE=""

# Способ 1 (рекомендуется для постоянной работы): ключ сервисного аккаунта.
# IAM-токен получается и обновляется автоматически, ничего не истекает.
#   1) Сервисному аккаунту выдайте роль ydb.editor на базу;
#   2) создайте авторизованный ключ: yc iam key create --service-account-name <имя> -o authorized_key.json
#   3) значение — base64 файла без переносов строк:  base64 -w0 authorized_key.json
#      (macOS: base64 -i authorized_key.json | tr -d '\n'). Можно вставить и сам JSON целиком.
# Не коммитьте это значение.
YDB_SERVICE_ACCOUNT_KEY=""

# Способ 2 (для быстрой проверки): готовый IAM-токен. ЖИВЁТ ОКОЛО 12 ЧАСОВ, затем YDB отвечает
# UNAUTHENTICATED, и вход перестаёт работать. Получить новый: yc iam create-token. Не коммитьте это значение.
YDB_TOKEN=""

# Адрес IAM (по умолчанию https://iam.api.cloud.yandex.net/iam/v1/tokens) — менять обычно не нужно.
# YDB_IAM_ENDPOINT=""

# Приложение стартует без БД, но постоянное хранение доступно только при заданных YDB_*.
YDB_AUTO_SCHEMA=true
# Демо-данные (включая демо-сотрудников без паролей) нужны только для разработки.
# В production оставьте false.
YDB_AUTO_SEED=false

# ------------------------------------------------------------------------------
# Аутентификация
# ------------------------------------------------------------------------------
# Секрет подписи сессий (обязателен в production, не короче 32 символов).
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Если сменить секрет, все сотрудники будут разлогинены. Не коммитьте это значение.
# В разработке без AUTH_SECRET используется временный ключ (сессии сбрасываются при перезапуске).
AUTH_SECRET=""

# Первый администратор. Войти в систему можно только по паролю, а пароли пока никому не заданы.
# При старте сервера (и командой `npm run auth:bootstrap`):
#   - сотрудник с таким email есть, пароля нет  -> ставится этот пароль;
#   - сотрудника нет                            -> создаётся администратор (и аккаунт компании);
#   - пароль уже задан                          -> ничего не меняется.
# После первого входа удалите BOOTSTRAP_ADMIN_PASSWORD из окружения.
# Для демо-данных (YDB_AUTO_SEED=true) подойдёт email admin@aroma-coffee.ru.
# На Vercel эти переменные НЕ читаются (сервер там не запускается как процесс): создайте администратора
# один раз локально командой `npm run auth:bootstrap` с теми же YDB_* в локальном .env.
# ВАЖНО: пароль задавайте только в своём .env или панели хостинга — этот файл попадает в репозиторий.
# Пароль не короче 8 символов и не из списка простых («12345678», «password», «admin» и т.п. отклоняются).
BOOTSTRAP_ADMIN_EMAIL="admin@aroma-coffee.ru"
BOOTSTRAP_ADMIN_PASSWORD=""
BOOTSTRAP_ADMIN_NAME="Администратор"
BOOTSTRAP_ADMIN_ACCOUNT_ID="acc-aroma"
BOOTSTRAP_ADMIN_ACCOUNT_NAME="Coffee City"
# Значений по умолчанию нет: без BOOTSTRAP_ADMIN_EMAIL и BOOTSTRAP_ADMIN_PASSWORD ничего не создаётся.

# За reverse-proxy (nginx и т.п.) включите, чтобы ограничение попыток входа считало реальные IP.
# На Vercel включается автоматически.
# TRUST_PROXY=true

# Источники, чьи запросы на изменение данных считаются «своими» помимо хоста самого сервера.
# Только точные origin через запятую (https://app.example.com). Маски и поддомены не поддерживаются.
# Нужно редко: например, если прокси подменяет заголовок Host.
# TRUSTED_ORIGINS="https://app.example.com"

# Встроенный предпросмотр (iframe в AI Studio и т.п.) — ТОЛЬКО для разработки.
# Включает cookie SameSite=None; Partitioned и разрешает встраивание сайта в iframe.
# При NODE_ENV=production игнорируется: боевая среда всегда работает в строгом режиме.
# ALLOW_EMBEDDED_PREVIEW=true

# APP_URL и GEMINI_API_KEY в коде сейчас не используются — задавать их не требуется.
