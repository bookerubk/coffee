# ==============================================================================
# Переменные окружения для "Кофейня → Производство (Coffee ERP)"
# Скопируйте этот файл в .env и настройте параметры для вашего сервера:
# cp .env.example .env
# ==============================================================================

# Порт HTTP-сервера приложения (по умолчанию 3000)
PORT=3000

# Режим окружения: development или production
NODE_ENV=production

# Отключение HMR в iframe / продакшн окружении (true по умолчанию)
DISABLE_HMR=true

# Часовой пояс сервера (по умолчанию московское время для синхронизации дедлайнов слотов)
TZ=Europe/Moscow

# ------------------------------------------------------------------------------
# Подключение к YDB Cloud
# ------------------------------------------------------------------------------
# Получите endpoint и database path в консоли YDB Cloud.
# Для production используйте сервисный аккаунт и не храните токен в репозитории.
YDB_ENDPOINT="grpcs://ydb.serverless.yandexcloud.net:2135"
YDB_DATABASE="/ru-central1/b1example/etnexample"
YDB_TOKEN=""
# Альтернатива YDB_TOKEN для сервисного аккаунта:
# YDB_SERVICE_ACCOUNT_KEY_FILE="/absolute/path/key.json"
# YDB_SERVICE_ACCOUNT_ID="aje..."

# Приложение стартует без БД, но постоянное хранение доступно только при заданных YDB_*.
YDB_AUTO_SCHEMA=true
YDB_AUTO_SEED=false

# Базовый URL приложения (при развёртывании на домене или Cloud Run)
APP_URL="http://localhost:3000"

# Gemini AI API Key (опционально, для AI-функций анализа)
GEMINI_API_KEY=""
